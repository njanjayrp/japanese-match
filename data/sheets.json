[
    {
        "id": "time",
        "title": "When things happen",
        "blurb": "Relative time words. Most of this grid is built from six prefixes — the marked cells are the ones that break the pattern and have to be memorised on their own.",
        "legend": [
            { "term": "sensen-", "gloss": "before last" },
            { "term": "sen-",    "gloss": "last" },
            { "term": "kon-",    "gloss": "this" },
            { "term": "rai-",    "gloss": "next" },
            { "term": "sarai-",  "gloss": "after next" },
            { "term": "mai-",    "gloss": "every" }
        ],
        "grids": [
            {
                "title": "day · morning · night",
                "columns": ["day", "morning", "night"],
                "rows": [
                    { "label": "−2", "cells": [
                        { "kana": "おととい", "en": "day before yesterday" },
                        { "kana": "おとといのあさ", "romaji": "ototoi no asa", "en": "morning before last" },
                        { "kana": "おとといのばん", "romaji": "ototoi no ban", "en": "night before last" }
                    ] },
                    { "label": "−1", "cells": [
                        { "kana": "きのう", "en": "yesterday" },
                        { "kana": "きのうのあさ", "romaji": "kinou no asa", "en": "yesterday morning" },
                        { "kana": "きのうのばん", "romaji": "kinou no ban", "en": "last night" }
                    ] },
                    { "label": "now", "cells": [
                        { "kana": "きょう", "en": "today" },
                        { "kana": "けさ", "en": "this morning", "odd": true },
                        { "kana": "こんばん", "en": "tonight", "odd": true }
                    ] },
                    { "label": "+1", "cells": [
                        { "kana": "あした", "en": "tomorrow" },
                        { "kana": "あしたのあさ", "romaji": "ashita no asa", "en": "tomorrow morning" },
                        { "kana": "あしたのばん", "romaji": "ashita no ban", "en": "tomorrow night" }
                    ] },
                    { "label": "+2", "cells": [
                        { "kana": "あさって", "en": "day after tomorrow" },
                        { "kana": "あさってのあさ", "romaji": "asatte no asa", "en": "morning after next" },
                        { "kana": "あさってのばん", "romaji": "asatte no ban", "en": "night after next" }
                    ] },
                    { "label": "each", "cells": [
                        { "kana": "まいにち", "en": "every day" },
                        { "kana": "まいあさ", "en": "every morning" },
                        { "kana": "まいばん", "en": "every night" }
                    ] }
                ]
            },
            {
                "title": "week · month · year",
                "columns": ["week", "month", "year"],
                "rows": [
                    { "label": "−2", "cells": [
                        { "kana": "せんせんしゅう", "en": "week before last" },
                        { "kana": "せんせんげつ", "en": "month before last" },
                        { "kana": "おととし", "en": "year before last", "odd": true }
                    ] },
                    { "label": "−1", "cells": [
                        { "kana": "せんしゅう", "en": "last week" },
                        { "kana": "せんげつ", "en": "last month" },
                        { "kana": "きょねん", "en": "last year", "odd": true }
                    ] },
                    { "label": "now", "cells": [
                        { "kana": "こんしゅう", "en": "this week" },
                        { "kana": "こんげつ", "en": "this month" },
                        { "kana": "ことし", "en": "this year", "odd": true }
                    ] },
                    { "label": "+1", "cells": [
                        { "kana": "らいしゅう", "en": "next week" },
                        { "kana": "らいげつ", "en": "next month" },
                        { "kana": "らいねん", "en": "next year" }
                    ] },
                    { "label": "+2", "cells": [
                        { "kana": "さらいしゅう", "en": "week after next" },
                        { "kana": "さらいげつ", "en": "month after next" },
                        { "kana": "さらいねん", "en": "year after next" }
                    ] },
                    { "label": "each", "cells": [
                        { "kana": "まいしゅう", "en": "every week" },
                        { "kana": "まいつき", "en": "every month", "odd": true },
                        { "kana": "まいとし", "en": "every year", "odd": true }
                    ] }
                ]
            }
        ],
        "rules": [
            {
                "title": "Six prefixes, twelve words",
                "body": "Stick the prefixes onto shuu (week) or getsu (month) and both of those columns fall out with no exceptions: senshuu, konshuu, raishuu, saraishuu. Same for sengetsu, kongetsu, raigetsu, saraigetsu."
            },
            {
                "title": "Year only listens to half of them",
                "body": "rainen and sarainen behave. The other four are their own words and have to be learnt flat: ototoshi, kyonen, kotoshi, maitoshi (also heard as mainen)."
            },
            {
                "title": "Morning and night are just glue",
                "body": "day + no + asa/ban, every time: kinou no asa, ashita no ban, asatte no asa. Only kesa (this morning) and konban (tonight) refuse to play. The mai- row drops the no: maiasa, maiban."
            },
            {
                "title": "The exceptions cluster around now",
                "body": "kyou, kesa, konban, kotoshi. The words you say most often are the ones that wore down — that is where to expect irregularity, in any language."
            },
            {
                "title": "Two freebies",
                "body": "oto- means 'before last' on both scales: ototoi, ototoshi. And the future starts with a: ashita (+1), asatte (+2). mai- is the one prefix that works in every single column."
            },
            {
                "title": "None of these take ni",
                "body": "Relative time words hook onto the sentence bare: kyou ikimasu, senshuu ikimashita, mainichi benkyou shimasu. ni is for time that carries a number or a calendar slot — kuji ni, shichigatsu ni, tanjoubi ni. Saying senshuu ni is the usual slip. itsu never takes it either — itsu ikimasu ka. Parts of the day and shuumatsu sit in between: asa ni hon o yomimasu and asa hon o yomimasu are both fine."
            }
        ]
    },
    {
        "id": "weekdays",
        "title": "Days of the week",
        "blurb": "One suffix and seven prefixes. The prefixes are the classical planets — the same week the Romans named, so the order is one you already know.",
        "legend": [
            { "term": "-youbi", "gloss": "day of the week" }
        ],
        "grids": [
            {
                "title": "the seven days",
                "columns": ["weekday", "what the prefix means"],
                "rows": [
                    { "label": "Mon", "cells": [
                        { "kana": "げつようび", "en": "Monday" },
                        { "term": "月", "en": "moon → Monday, lundi" }
                    ] },
                    { "label": "Tue", "cells": [
                        { "kana": "かようび", "en": "Tuesday" },
                        { "term": "火", "en": "fire → Mars, mardi" }
                    ] },
                    { "label": "Wed", "cells": [
                        { "kana": "すいようび", "en": "Wednesday" },
                        { "term": "水", "en": "water → Mercury, mercredi" }
                    ] },
                    { "label": "Thu", "cells": [
                        { "kana": "もくようび", "en": "Thursday" },
                        { "term": "木", "en": "wood → Jupiter, jeudi" }
                    ] },
                    { "label": "Fri", "cells": [
                        { "kana": "きんようび", "en": "Friday" },
                        { "term": "金", "en": "gold → Venus, vendredi" }
                    ] },
                    { "label": "Sat", "cells": [
                        { "kana": "どようび", "en": "Saturday" },
                        { "term": "土", "en": "earth → Saturn, Saturday" }
                    ] },
                    { "label": "Sun", "cells": [
                        { "kana": "にちようび", "en": "Sunday" },
                        { "term": "日", "en": "sun → the Sun, Sunday" }
                    ] },
                    { "label": "?", "cells": [
                        { "kana": "なんようび", "en": "what day of the week?" },
                        { "term": "何", "en": "'what' drops into the same slot" }
                    ] }
                ]
            }
        ],
        "rules": [
            {
                "title": "One suffix does all the work",
                "body": "Every weekday is prefix + youbi. Learn seven syllables — getsu, ka, sui, moku, kin, do, nichi — and the whole week falls out. Nothing here is irregular."
            },
            {
                "title": "It is our week, borrowed twice",
                "body": "Moon, Mars, Mercury, Jupiter, Venus, Saturn, Sun. Japanese took the same planetary week from the same ancient source, which is why kayoubi (fire → Mars) lines up with mardi and mokuyoubi (wood → Jupiter) with jeudi. If you know the French or English names you already know the order."
            },
            {
                "title": "The apostrophe is a real sound",
                "body": "kin'youbi and nan'youbi, not kinyoubi. The n stands on its own and the y starts the next syllable — say kin, then youbi."
            },
            {
                "title": "Asking uses the same shape",
                "body": "nan'youbi desu ka — what day is it? Also worth knowing: Japanese calendars usually start the week on Sunday, not Monday."
            }
        ]
    },
    {
        "id": "clock",
        "title": "Reading the clock",
        "blurb": "Two suffixes and numbers you already know. Hour then minute, no word for 'past' or 'to' — but three hours lie about their own number, and the minute suffix flips between fun and pun.",
        "legend": [
            { "term": "ji",        "gloss": "o'clock" },
            { "term": "fun / pun", "gloss": "minutes" },
            { "term": "han",       "gloss": "half past" },
            { "term": "gozen",     "gloss": "a.m." },
            { "term": "gogo",      "gloss": "p.m." }
        ],
        "grids": [
