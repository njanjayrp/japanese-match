        "rules": [
            {
                "title": "Number + gatsu, always",
                "body": "The shape never bends: ichigatsu, nigatsu, sangatsu, gogatsu. Only the number bends its reading — shigatsu, shichigatsu, kugatsu. There is no yongatsu, nanagatsu or kyuugatsu."
            },
            {
                "title": "4, 7 and 9 again — but not the same way",
                "body": "The clock trips on the same three numbers, and only two of them agree: shichiji / shichigatsu and kuji / kugatsu match, but the hour is yoji while the month is shigatsu. 4 is the one to watch."
            },
            {
                "title": "The first ten are their own words",
                "body": "tsuitachi, futsuka, mikka, yokka, itsuka, muika, nanoka, youka, kokonoka, tooka. Note tsuitachi only means the 1st — one day is ichinichi."
            },
            {
                "title": "Three survivors above ten",
                "body": "juuyokka (14), hatsuka (20) and nijuuyokka (24) keep the old reading. Everything else from 11 to 31 is just the number + nichi: juuichinichi, nijuurokunichi, sanjuuichinichi."
            },
            {
                "title": "Both take ni",
                "body": "A date or a month is a calendar slot, so it takes ni: shigatsu ni ikimasu, hatsuka ni kaerimasu. Compare kyou, ashita and senshuu, which take nothing at all."
            }
        ]
